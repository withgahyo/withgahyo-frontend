# API 서버 주소
VITE_API_BASE_URL=

# 코스 상세 화면을 mock 데이터로 렌더한다. 'true' 일 때만 mock 사용, 그 외엔 실제 API 호출.
# 백엔드/AI 서버 연동 전 임시 플래그 — 연동 완료되면 제거.
VITE_USE_COURSE_MOCK=

# Kakao Maps JavaScript SDK 앱 키 (Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키)
# 실제 키는 커밋하지 말고 로컬 .env 에만 채워 넣는다.
VITE_KAKAO_MAP_APP_KEY=

# 소셜 로그인 OAuth 클라이언트 ID
VITE_KAKAO_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
